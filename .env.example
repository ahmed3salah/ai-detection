# Copy to .env and fill in your keys. Never commit .env.

# OpenRouter (recommended: one key for many models)
OPENROUTER_API_KEY=sk-or-...

# Or use providers directly:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# GEMINI_API_KEY=...

# Optional overrides
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OPENAI_API_BASE=https://...
# OLLAMA_BASE_URL=http://localhost:11434/v1

# API container: optional S3 sync before uvicorn (see DEPLOY.md)
# MODEL_S3_URI=s3://my-bucket/path/to/model-prefix
# MODEL_S3_REGION=us-east-1
# DETECTION_API_KEY=...
